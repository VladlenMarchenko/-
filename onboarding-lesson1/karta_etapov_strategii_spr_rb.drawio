46" y="502" width="140" height="54" as="geometry"/></mxCell><mxCell id="65" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#00875A;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1"><mxGeometry x="204" y="468" width="160" height="96" as="geometry"/></mxCell><mxCell id="66" value="&lt;b style=&quot;font-size:16px;color:#00875A&quot;&gt;②&lt;/b&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="212" y="474" width="30" height="24" as="geometry"/></mxCell><mxCell id="67" value="&lt;b style=&quot;font-size:11px;color:#172B4D&quot;&gt;Одобрить и выйти&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#6B778C&quot;&gt;сразу на шаг 6 → Accept&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="214" y="502" width="140" height="54" as="geometry"/></mxCell><mxCell id="68" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#FF8B00;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1"><mxGeometry x="372" y="468" width="160" height="96" as="geometry"/></mxCell><mxCell id="69" value="&lt;b style=&quot;font-size:16px;color:#FF8B00&quot;&gt;③&lt;/b&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="380" y="474" width="30" height="24" as="geometry"/></mxCell><mxCell id="70" value="&lt;b style=&quot;font-size:11px;color:#172B4D&quot;&gt;Доп. источники и остаться&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#6B778C&quot;&gt;повтор текущего этапа&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="382" y="502" width="140" height="54" as="geometry"/></mxCell><mxCell id="71" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#0065FF;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="468" width="160" height="96" as="geometry"/></mxCell><mxCell id="72" value="&lt;b style=&quot;font-size:16px;color:#0065FF&quot;&gt;④&lt;/b&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="548" y="474" width="30" height="24" as="geometry"/></mxCell><mxCell id="73" value="&lt;b style=&quot;font-size:11px;color:#172B4D&quot;&gt;Доп. источники и перейти&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#6B778C&quot;&gt;на другой этап (PRB/PRV/POV)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="550" y="502" width="140" height="54" as="geometry"/></mxCell><mxCell id="74" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#0052CC;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1"><mxGeometry x="708" y="468" width="160" height="96" as="geometry"/></mxCell><mxCell id="75" value="&lt;b style=&quot;font-size:16px;color:#0052CC&quot;&gt;⑤&lt;/b&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="716" y="474" width="30" height="24" as="geometry"/></mxCell><mxCell id="76" value="&lt;b style=&quot;font-size:11px;color:#172B4D&quot;&gt;Дальше без доп. вызовов&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#6B778C&quot;&gt;следующий этап по основному ходу&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="718" y="502" width="140" height="54" as="geometry"/></mxCell><mxCell id="77" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#B3D4FF;" vertex="1" parent="1"><mxGeometry x="20" y="598" width="1060" height="64" as="geometry"/></mxCell><mxCell id="78" value="&lt;b style=&quot;color:#0747A6&quot;&gt;Что смотреть на дежурстве&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#172B4D&quot;&gt;1) rm_req_log — заявка вошла · 2) sm_req/res_log / rm_gen_log — этап PRH/PRB/PRV/POV · 3) маркеры TIMEOUT/ERROR у источника · 4) rm_res_log — ушло ли решение · 5) эскалация — карта коммуникаций&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="32" y="606" width="1030" height="48" as="geometry"/></mxCell><mxCell id="79" value="&lt;b style=&quot;font-size:14px;color:#172B4D&quot;&gt;Справка по шагам&lt;/b&gt;" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="676" width="300" height="22" as="geometry"/></mxCell><mxCell id="80" value="&lt;b&gt;Шаг&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#6B778C;" vertex="1" parent="1"><mxGeometry x="28" y="700" width="40" height="16" as="geometry"/></mxCell><mxCell id="81" value="&lt;b&gt;Название&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#6B778C;" vertex="1" parent="1"><mxGeometry x="70" y="700" width="100" height="16" as="geometry"/></mxCell><mxCell id="82" value="&lt;b&gt;Что происходит&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#6B778C;" vertex="1" parent="1"><mxGeometry x="200" y="700" width="500" height="16" as="geometry"/></mxCell><mxCell id="83" value="&lt;b&gt;Переход&lt;/b&gt;" style="text;html=1;fontSize=10;fontColor=#6B778C;" vertex="1" parent="1"><mxGeometry x="780" y="700" width="120" height="16" as="geometry"/></mxCell><mxCell id="84" value="&lt;b style=&quot;color:#00875A&quot;&gt;0&lt;/b&gt;" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="28" y="718" width="30" height="15" as="geometry"/></mxCell><mxCell id="85" value="&lt;b&gt;Начало&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="70" y="718" width="120" height="15" as="geometry"/></mxCell><mxCell id="86" value="Заявка поступила от фронт-системы" style="text;html=1;fontSize=10;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="200" y="718" width="560" height="15" as="geometry"/></mxCell><mxCell id="87" value="→ 1" style="text;html=1;fontSize=10;fontColor=#6B778C;" vertex="1" parent="1"><mxGeometry x="780" y="718" width="200" height="15" as="geometry"/></mxCell><mxCell id="88" value="&lt;b style=&quot;color:#0052CC&quo